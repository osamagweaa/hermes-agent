_config_version: 50
agent:
  fast_auto_seconds: 60
  max_turns: 500
  personalities: {}
  reasoning_effort: medium
  reasoning_overrides: {}
  service_tier: ""
  verbose: false
attachments:
  storage: hermes-home
auth:
  adopt_external_logins: true
  codex_login_flow: device_code
browser:
  extension_control:
    enabled: false
  inactivity_timeout: 120
code_execution:
  max_tool_calls: 50
  timeout: 300
compression:
  checkpoint_required: false
  codex_app_server_auto: native
  codex_gpt55_autoraise: true
  codex_responses_compact_threshold:
  codex_responses_native: false
  enabled: true
  hygiene_max_turn_hold_seconds: 10
  idle_compact_after_seconds: 0
  max_attempts: 3
  min_tail_user_messages: 1
  proactive_prune_min_reclaim_tokens: 4096
  proactive_prune_min_result_chars: 8000
  proactive_prune_tokens: 0
  progress_notices: false
  protect_first_n: 3
  protect_last_n: 20
  target_ratio: 0.2
  threshold: 0.5
cron:
  catch_up_missed: true
database:
  journal_mode: wal
delegation:
  max_iterations: 250
display:
  background_process_notifications: concise
  bell_on_complete: false
  bell_on_prompt: false
  busy_input_mode: interrupt
  cleanup_progress: false
  compact: false
  skin: default
  streaming: true
  suppress_warning_notifications: false
gateway:
group_sessions_per_user: true
kanban:
  review_dispatch: true
max_concurrent_sessions:
memory:
  memory_char_limit: 2200
  memory_enabled: true
  nudge_interval: 10
  prefetch_spill_enabled: false
  user_char_limit: 1375
  user_profile_enabled: true
model:
  api_key: ollama
  base_url: http://127.0.0.1:11434/v1
  default: gemma4:31b-cloud
  provider: ollama-launch
onboarding:
  seen:
    busy_input_prompt: true
    tool_progress_prompt: true
platform_toolsets:
  cli:
    - hermes-cli
  discord:
    - hermes-discord
  google_chat:
    - hermes-google_chat
  qqbot:
    - hermes-qqbot
  signal:
    - hermes-signal
  slack:
    - hermes-slack
  teams:
    - hermes-teams
  telegram:
    - hermes-telegram
  whatsapp:
    - hermes-whatsapp
  yuanbao:
    - hermes-yuanbao
plugins:
  clone_timeout_seconds: 300
prompt_caching:
  cache_ttl: 5m
providers:
  ollama-launch:
    api: http://127.0.0.1:11434/v1
    default_model: kimi-k2.7-code:cloud
    models:
      - kimi-k2.7-code:cloud
      - gemma4:e2b-it-qat
      - gemma4:26b
      - gemma4:31b-cloud
      - uncensoredai/diddy:latest
      - glm-5.2:cloud
      - qwen2.5:3b
    name: Ollama
runtime:
  nofile_soft_limit: 4096
skills:
  creation_nudge_interval: 15
streaming:
  enabled: false
stt:
  enabled: true
  language: en
  local:
    model: base
  openai:
    language: ""
    max_retries: 1
    model: whisper-1
    timeout: 60
telemetry:
  shared_metrics:
    enabled: true
    offer_version: 2
    send: false
terminal:
  backend: local
  container_cpu: 1
  container_disk: 51200
  container_memory: 5120
  container_persistent: true
  cwd: .
  docker_mount_cwd_to_workspace: false
  home_mode: auto
  lifetime_seconds: 300
  timeout: 180
tool_loop_guardrails:
  hard_stop_after:
    exact_failure: 5
    idempotent_no_progress: 5
    same_tool_failure: 8
  hard_stop_enabled: false
  non_interactive_hard_stop_enabled: true
  warn_after:
    exact_failure: 2
    idempotent_no_progress: 2
    same_tool_failure: 3
  warnings_enabled: true
toolsets:
  - hermes-cli
  - web
updates:
  backup_keep: 5
  check: true
  non_interactive_local_changes: stash
  pre_update_backup: false
fallback_providers:
  - provider: openrouter
    model: openrouter/free
